# Credentials of the dev-only tools. Copy to .env (git-ignored) and fill in.
# Load them into a shell with: set -a && . ./.env && set +a
# Never commit real values, and never print them in logs, issues or PRs.

# ENTSO-E Transparency Platform token: backtest --load entsoe / --outages entsoe
ENTSOE_API_KEY=

# Benchmark collector (scripts/benchmark.py collect): Carnot's forecast
CARNOT_API_KEY=
CARNOT_USER=

# Benchmark collector: this instance's forecast over Home Assistant's REST API
HA_URL=
HA_TOKEN=
# Only when the instance has several Open Spot Forecast entries
OSF_CONFIG_ENTRY_ID=

# Optional: a GitHub token raises the rate limit of the Smartere Elforbrug backfill
GITHUB_TOKEN=
