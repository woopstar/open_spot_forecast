// See https://containers.dev/implementors/json_reference/ for format details.
{
  "name": "OSF",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "postCreateCommand": "/usr/local/bin/post-create.sh",
  "postStartCommand": "/usr/local/bin/post-start.sh",
  "runArgs": ["--name", "osf-devcontainer", "--restart", "always"],
  "remoteUser": "root",
  // "forwardPorts": [8123],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/osf,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/osf",
  "mounts": [
    "source=osf-root,target=/root,type=volume",
    "type=bind,source=${localEnv:HOME}/.ssh,target=/root/.ssh,readonly",
    "type=bind,source=${localEnv:HOME}/.gnupg,target=/root/.gnupg",
    "type=bind,source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig",
    "source=osf-cache,target=/tmp/osf-cache,type=volume",
    "source=osf-worktrees,target=/workspaces/worktrees,type=volume"
  ],
  "containerEnv": {
    "WORKSPACE_DIR": "/workspaces/osf",
    "PYTHONPYCACHEPREFIX": "/tmp/osf-cache/pycache",
    "MYPY_CACHE_DIR": "/tmp/osf-cache/mypy",
    "PYTEST_CACHE_DIR": "/tmp/osf-cache/pytest",
    "RUFF_CACHE_DIR": "/tmp/osf-cache/ruff",
    "UV_CACHE_DIR": "/tmp/osf-cache/uv",
    "SSH_AUTH_SOCK": "/tmp/ssh-agent.sock",
    "SSH_AGENT_PORT": "9999",
    "GPG_AGENT_PORT": "9998",
    "SCDAEMON_PORT": "9997",
    "SSH_AGENT_HOST": "host.docker.internal"
  }
}
